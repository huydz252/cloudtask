PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/cloudtask_db?schema=public
JWT_SECRET=replace_with_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
TRUST_PROXY=0
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=
# On AWS use an ECS task role / EC2 instance role instead of static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=10485760
SEED_EMAIL=demo@cloudtask.local
SEED_PASSWORD=
