[
  {
    "AllowedHeaders": [
      "content-type",
      "x-amz-meta-attachment-id",
      "x-amz-checksum-*",
      "x-amz-sdk-checksum-algorithm"
    ],
    "AllowedMethods": ["PUT", "GET", "HEAD"],
